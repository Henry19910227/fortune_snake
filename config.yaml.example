app: # 应用基本配置
  app_name: game_server_mini_rocket_crash # 应用名称
  ip: 127.0.0.1 # 服务监听IP(rpc服务访问使用)
  port: 8181 # 服务监听端口号
  server_node: 1 #  服务器节点

language: #语言包相关
  default: "zh-CN" #默认语言包
  support_languages:
    - "zh-CN"
    - "en-US"

etcd:
  endpoints:
    - "127.0.0.1:2379"  # Etcd 地址
  service_prefix: "/game_services/rocket_crash"
  ttl: 10  # 注册信息的过期时间（秒）

database:
  driver: mysql # 数据库驱动
  host: 18.167.41.209 # 域名
  port: 4000 # 端口号
  database: goplay # 数据库名称
  username: root # 用户名
  password: rkdiAdl39adkadAdYTzS2d9 # 密码
  charset: utf8mb4 # 编码格式
  max_idle_conns: 10 # 空闲连接池中连接的最大数量
  max_open_conns: 100 # 打开数据库连接的最大数量
  log_mode: info # 日志级别
  enable_file_log_writer: true # 是否启用日志文件
  log_filename: sql.log # 日志文件名称

redis:
  master_name: "mymaster"
  sentinel_address:
    - "18.167.41.209:6392"
    - "18.167.41.209:6393"
    - "18.167.41.209:6394"
  password: "ac666818ce69cc187c2134c3a14"            # Redis 主/从节点的密码
  sentinel_password: "ac666818ce69cc187c2134c3a14"   # Sentinel 的认证密码
  db: 0

mongodb:
  username: "newslots1"
  password: "317594080b2e96f6a396d2bd442c8502"
  hosts:
    - "18.167.41.209:25130"
    - "18.167.41.209:25131"
    - "18.167.41.209:25132"
  database: "goplay"
  auth_source: "admin"